      "text": "### | مجالس سیعه\r\n"
    },
    {
      "line_number": 2320,
      "char_start": 100158,
      "char_end": 100215,
      "text": "# ««گنجینهآ اسرار الهی ماییم %~% بحر درر نامتناهی ماییم\r\n"
    },
    {
      "line_number": 2321,
      "char_start": 100215,
      "char_end": 100282,
      "text": "# بنشسته به تخت پادشاهی ماییم %~% بگرفته زماه تا به ماهی ماییم»25\r\n"
    },
    {
      "line_number": 2322,
      "char_start": 100282,
      "char_end": 100354,
      "text": "# ~~هنوز گذریان وجود، در بازار شهود ننشسته بودند26، هنوز نه ولولهآ ملک\r\n"
    },
    {
      "line_number": 2323,
      "char_start": 100354,
      "char_end": 100377,
      "text": "~~بود، نه مشعلهآ فلک،\r\n"
    },
    {
      "line_number": 2324,
      "char_start": 100377,
      "char_end": 100449,
      "text": "# ~~نه سمک در زیر زمین جنبیده، نه سماک برافلاک درخشیده، هنوزنقاشان قدر\r\n"
    },
    {
      "line_number": 2325,
      "char_start": 100449,
      "char_end": 100470,
      "text": "~~این صفهآ گچ اندود\r\n"
    },
    {
      "line_number": 2326,
      "char_start": 100470,
      "char_end": 100539,
      "text": "# ~~صف آسمان رایردهآ لاژوردی نکشیده بودند، هنوزفراشان قضا، فضای این\r\n"
    },
    {
      "line_number": 2327,
      "char_start": 100539,
      "char_end": 100555,
      "text": "~~چارطاق عناصر\r\n"
    },
    {
      "line_number": 2328,
      "char_start": 100555,
      "char_end": 100627,
      "text": "# ~~در بیدای وجود27 نزده بودند که نور وجود من که صبح شهود بود، از مشرق\r\n"
    },
    {
      "line_number": 2329,
      "char_start": 100627,
      "char_end": 100648,
      "text": "~~«(انا ارسلناک»»28\r\n"
    },
    {
      "line_number": 2330,
      "char_start": 100648,
      "char_end": 100719,
      "text": "# ~~لمعان نموده، به امر «کن»29 هست گشتم وبه شراب «(قل»30 مست گشتم، تا\r\n"
    },
    {
      "line_number": 2331,
      "char_start": 100719,
      "char_end": 100732,
      "text": "~~نوبت نبوت\r\n"
    },
    {
      "line_number": 2332,
      "char_start": 100732,
      "char_end": 100803,
      "text": "# ~~من، نوبتیان قضا، بر در سراپردهآ آدم نزده بودند،31 هیچ فرشته ای را\r\n"
    },
    {
      "line_number": 2333,
      "char_start": 100803,
      "char_end": 100837,
      "text": "~~زهرهآ آن نبود که پایهآ تخت آدم\r\n"
    },
    {
      "line_number": 2334,
      "char_start": 100837,
      "char_end": 100849,
      "text": "# ~~ببوسد.\r\n"
    },
    {
      "line_number": 2335,
      "char_start": 100849,
      "char_end": 100875,
      "text": "# ((مقصود ز عالم آدم آمد\r\n"
    },
    {
      "line_number": 2336,
      "char_start": 100875,
      "char_end": 100903,
      "text": "# مقصود ز آدم آن دم امد»32\r\n"
    },
    {
      "line_number": 2337,
      "char_start": 100903,
      "char_end": 100972,
      "text": "# ~~چون به عالم وجود آمدم، مستخبران روزگار به استفسار حال من آمدند.\r\n"
    },
    {
      "line_number": 2338,
      "char_start": 100972,
      "char_end": 101027,
      "text": "# ای مسند تو ورای افلاک %~% قدر تو و خاک توده ، خاشاک\r\n"
    },
    {
      "line_number": 2339,
      "char_start": 101027,
      "char_end": 101075,
      "text": "# طغرای جلال تو لعمرک %~% منشور ولایت تو لولاک\r\n"
    },
    {
      "line_number": 2340,
      "char_start": 101075,
      "char_end": 101128,
      "text": "# نه حقه وهفت مهره پیشت %~% دست تو و دامن توزان پاک\r\n"
    },
    {
      "line_number": 2341,
      "char_start": 101128,
      "char_end": 101180,
      "text": "# نقش صفحات رایت تو %~% لولاک لما خلقت الا فلاک)33\r\n"
    },
    {
      "line_number": 2342,
      "char_start": 101180,
      "char_end": 101259,
      "text": "# ~~که محمدا تویی عادل، تویی در شهر ms060 شریعت. گفتم چه جای این است! که همهآ\r\n"
    },
    {
      "line_number": 2343,
      "char_start": 101259,
      "char_end": 101272,
      "text": "~~بیغامبران\r\n"
    },
    {
      "line_number": 2344,
      "char_start": 101272,
      "char_end": 101345,
      "text": "# ~~منشور عمل توکیل در من یافته اند. دم آدم، فتح نوح، درس ادریس، مؤانست\r\n"
    },
    {
      "line_number": 2345,
      "char_start": 101345,
      "char_end": 101359,
      "text": "~~موسی، حدیث\r\n"
    },
    {
      "line_number": 2346,
      "char_start": 101359,
      "char_end": 101409,
      "text": "# ~~شیث، تبجیل اسماعیل وخلت خلیل، همه با من است.\r\n"
    },
    {
      "line_number": 2347,
      "char_start": 101409,
      "char_end": 101476,
      "text": "# # کشتی وجود مرد دانا عجب است %~% افتاده به چاه مرد بینا عجب است\r\n"
    },
    {
      "line_number": 2348,
      "char_start": 101476,
      "char_end": 101549,
      "text": "# # کشتی که به دریا بود آن نیست عجب %~% در یک کشتی هزاردریا عجب است))34\r\n"
    },
    {
      "line_number": 2349,
      "char_start": 101549,
      "char_end": 101564,
      "text": "~~PageV01P064\r\n"
    },
    {
      "line_number": 2350,
      "char_start": 101564,
      "char_end": 101628,
      "text": "# ![image filename](./0672JalalDinRumi.MajalisSabica_0076.png)\r\n"
    },
    {
      "line_number": 2351,
      "char_start": 101628,
      "char_end": 101630,
      "text": "\r\n"
    },
    {
      "line_number": 2352,
      "char_start": 101630,
      "char_end": 101644,
      "text": "# ~~مجلس دوم\r\n"
    },
    {
      "line_number": 2353,
      "char_start": 101644,
      "char_end": 101718,
      "text": "# ~~محمدا به حه کار آمده ای؟ آمدهام تا رندان محلت کفر را ادب کنم . مستان\r\n"
    },
    {
      "line_number": 2354,
      "char_start": 101718,
      "char_end": 101735,
      "text": "~~خرابات شرک را\r\n"
    },
    {
      "line_number": 2355,
      "char_start": 101735,
      "char_end": 101748,
      "text": "# ~~حد زنم.\r\n"
    },
    {
      "line_number": 2356,
      "char_start": 101748,
      "char_end": 101822,
      "text": "# روزی مهتر عالم و سروربنی آدم نشسته بود، و صحابه در پیش او حلقه زده، آن\r\n"
    },
    {
      "line_number": 2357,
      "char_start": 101822,
      "char_end": 101832,
      "text": "~~صدیقان\r\n"
    },
    {
      "line_number": 2358,
      "char_start": 101832,
      "char_end": 101902,
      "text": "# ~~صادق، آن خموشان ناطق، راز را با حضرت بی نیاز فرستاده بودند تا آن\r\n"
    },
    {
      "line_number": 2359,
      "char_start": 101902,
      "char_end": 101929,
      "text": "~~عنقای عالم غیب، به آواز\r\n"
    },
    {
      "line_number": 2360,
      "char_start": 101929,
      "char_end": 102003,
      "text": "# ~~«رقل)) آید و آن هزار دستان بوستان معرفت به شاخ گل آید و نوای عاشقانه\r\n"
    },
    {
      "line_number": 2361,
      "char_start": 102003,
      "char_end": 102026,
      "text": "~~بسراید و مراد دین و\r\n"
    },
    {
      "line_number": 2362,
      "char_start": 102026,
      "char_end": 102092,
      "text": "# ~~دنیا برآید. مهتر عالم، سردرج در اسرار بگشاد و این لفظ بر نطع\r\n"
    },
    {
      "line_number": 2363,
      "char_start": 102092,
      "char_end": 102122,
      "text": "~~بازرگانان جانباز جانان طلب\r\n"
    },
    {
      "line_number": 2364,
      "char_start": 102122,
      "char_end": 102194,
      "text": "# ~~معنی نهاد وچنین فرمود که: (من خرج من ذل المعاصی الی عزالتقوی»35 هر\r\n"
    },
    {
      "line_number": 2365,
      "char_start": 102194,
      "char_end": 102210,
      "text": "~~که قدم از ذل\r\n"
    },
    {
      "line_number": 2366,
      "char_start": 102210,
      "char_end": 102283,
      "text": "# ~~معصیت، بی تهمت ریا و غفلت به صحرای پرهیزگاری و ترسکاری نهد و کیمیای\r\n"
    },
    {
      "line_number": 2367,
      "char_start": 102283,
      "char_end": 102297,
      "text": "~~تقوی را به\r\n"
    },
    {
      "line_number": 2368,
      "char_start": 102297,
      "char_end": 102367,
      "text": "# ~~دست طلب معنی بر مس نفس سحارهآ غدارهآ مکارهآ اماره افکند و به قدم\r\n"
    },
    {
      "line_number": 2369,
      "char_start": 102367,
      "char_end": 102394,
      "text": "~~مجاهده سوی انوار مشاهده\r\n"
    },
    {
      "line_number": 2370,
      "char_start": 102394,
      "char_end": 102466,
      "text": "# ~~رود، ««اغناه الله بلامال» 36 کمال فضل الهیت به محض لطف ربوبیت، این\r\n"
    },
    {
      "line_number": 2371,
      "char_start": 102466,
      "char_end": 102484,
      "text": "~~بنده را بی مال\r\n"
    },
    {
      "line_number": 2372,
      "char_start": 102484,
      "char_end": 102504,
      "text": "# ~~توانگر گرداند.\r\n"
    },
    {
      "line_number": 2373,
      "char_start": 102504,
      "char_end": 102565,
      "text": "# # ((بس که شنیدی صفت روم وچین %~% خیز و بیا ملک سنایی ببین\r\n"
    },
    {
      "line_number": 2374,
      "char_start": 102565,
      "char_end": 102631,
      "text": "# # تا همه دل بینی بی حرص وبخل %~% تا همه جان بینی، بی کبر و کین\r\n"
    },
    {
      "line_number": 2375,
      "char_start": 102631,
      "char_end": 102690,
      "text": "# # پای نه و عرشن به زیر قدم %~% دست نه و ملک به زیر نگین\r\n"
    },
    {
      "line_number": 2376,
      "char_start": 102690,
      "char_end": 102751,
      "text": "# # گاه ولی گوید: هست او چنان %~% گاه عدو گوید: هست او چنین\r\n"
    },
    {
      "line_number": 2377,
      "char_start": 102751,
      "char_end": 102818,
      "text": "# # او زهمه فارغ و آزاد وخوش %~% چون گل و چون سوسن وچون یاسمین»37\r\n"
    },
    {
      "line_number": 2378,
      "char_start": 102818,
      "char_end": 102884,
