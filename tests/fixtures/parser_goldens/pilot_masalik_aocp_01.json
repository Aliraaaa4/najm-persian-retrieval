        "char_start": 251127,
        "char_end": 251181,
        "line_start": 5295,
        "line_end": 5295,
        "raw_text": "~~میباشد. بعد از آن گروه اکره ، پس از آن گروه مهان2.\r\n",
        "group_id": "paragraph_0003",
        "attributes": {
