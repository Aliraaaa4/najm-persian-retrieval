      "line_number": 5344,
      "char_start": 254108,
      "char_end": 254182,
      "text": "# و اما نشوی وبر کری21 واخلاط12 ومناز گرد 11 وبدلیس26وقالیقلا25 و ارزن26\r\n"
    }
  ],
