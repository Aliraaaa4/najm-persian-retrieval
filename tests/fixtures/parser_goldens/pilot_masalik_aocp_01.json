        "char_end": 251056,
        "line_start": 5293,
        "line_end": 5293,
        "raw_text": "~~که در آنجا متوطن اند ایشان بیشتراند.\r\n",
        "group_id": "paragraph_0002",
        "attributes": {
          "continuation": true,
          "orphan_continuation": false
