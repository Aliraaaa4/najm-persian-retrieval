    },
    {
      "line_number": 12956,
      "char_start": 805658,
      "char_end": 805722,
      "text": "# 1 ای ضیا الحق حسام الدین توی %~% که گذشت از مه به نورت مثنوی\r\n"
    },
    {
      "line_number": 12957,
      "char_start": 805722,
      "char_end": 805779,
      "text": "# 2 همت عالی تو ای مرتجا %~% می‌کشد این را خدا داند کجا\r\n"
    },
    {
      "line_number": 12958,
      "char_start": 805779,
      "char_end": 805841,
      "text": "# 3 گردن این مثنوی را بسته‌ای %~% می‌کشی آن سوی که دانسته‌ای\r\n"
    },
    {
      "line_number": 12959,
      "char_start": 805841,
      "char_end": 805903,
      "text": "# 4 مثنوی پویان کشنده ناپدید %~% ناپدید از جاهلی کش نیست دید\r\n"
    },
    {
      "line_number": 12960,
      "char_start": 805903,
      "char_end": 805968,
      "text": "# 5 مثنوی را چون تو مبدا بوده‌ای %~% گر فزون گردد توش افزوده‌ای\r\n"
    },
    {
      "line_number": 12961,
      "char_start": 805968,
      "char_end": 806029,
      "text": "# 6 چون چنین خواهی خدا خواهد چنین %~% می‌دهد حق آرزوی متقین\r\n"
    },
    {
      "line_number": 12962,
      "char_start": 806029,
      "char_end": 806091,
      "text": "# 7 کان لله بوده‌ای در ما مضی %~% تا که کان الله پیش آمد جزا\r\n"
    },
    {
      "line_number": 12963,
      "char_start": 806091,
      "char_end": 806155,
      "text": "# 8 مثنوی از تو هزاران شکر داشت %~% در دعا و شکر کفها بر فراشت\r\n"
    },
    {
      "line_number": 12964,
      "char_start": 806155,
      "char_end": 806218,
      "text": "# 9 در لب و کفش خدا شکر تو دید %~% فضل کرد و لطف فرمود و مزید\r\n"
    },
    {
      "line_number": 12965,
      "char_start": 806218,
      "char_end": 806281,
      "text": "# 10 زانک شاکر را زیادت وعده است %~% آنچنانک قرب مزد سجده است\r\n"
    },
    {
      "line_number": 12966,
      "char_start": 806281,
      "char_end": 806349,
      "text": "# 11 گفت واسجد واقترب یزدان ما %~% قرب جان شد سجده ابدان ما ms0556\r\n"
    },
    {
      "line_number": 12967,
      "char_start": 806349,
      "char_end": 806416,
      "text": "# 12 گر زیادت می‌شود زین رو بود %~% نه از برای بوش و های و هو بود\r\n"
    },
    {
      "line_number": 12968,
      "char_start": 806416,
      "char_end": 806487,
      "text": "# 13 با تو ما چون رز به تابستان خوشیم %~% حکم داری هین بکش تا می‌کشیم\r\n"
    },
    {
      "line_number": 12969,
      "char_start": 806487,
      "char_end": 806552,
      "text": "# 14 خوش بکش این کاروان را تا به حج %~% ای امیر صبر مفتاح الفرج\r\n"
    },
    {
      "line_number": 12970,
      "char_start": 806552,
      "char_end": 806608,
      "text": "# 15 حج زیارت کردن خانه بود %~% حج رب البیت مردانه بود\r\n"
    },
    {
      "line_number": 12971,
      "char_start": 806608,
      "char_end": 806675,
      "text": "# 16 زان ضیا گفتم حسام‌الدین ترا %~% که تو خورشیدی و این دو وصفها\r\n"
    },
    {
      "line_number": 12972,
      "char_start": 806675,
      "char_end": 806742,
      "text": "# 17 کین حسام و این ضیا یکیست هین %~% تیغ خورشید از ضیا باشد یقین\r\n"
    },
    {
      "line_number": 12973,
      "char_start": 806742,
      "char_end": 806809,
      "text": "# 18 نور از آن ماه باشد وین ضیا %~% آن خورشید این فرو خوان از نبا\r\n"
    },
    {
      "line_number": 12974,
      "char_start": 806809,
      "char_end": 806881,
      "text": "# 19 شمس را قرآن ضیا خواند ای پدر %~% و آن قمر را نور خواند این را نگر\r\n"
    },
    {
      "line_number": 12975,
      "char_start": 806881,
      "char_end": 806952,
      "text": "# 20 شمس چون عالی‌تر آمد خود ز ماه %~% پس ضیا از نور افزون دان به جاه\r\n"
    },
    {
      "line_number": 12976,
      "char_start": 806952,
      "char_end": 807017,
      "text": "# 21 بس کس اندر نور مه منهج ندید %~% چون برآمد آفتاب آن شد پدید\r\n"
    },
    {
      "line_number": 12977,
      "char_start": 807017,
      "char_end": 807077,
      "text": "# 22 آفتاب اعواض را کامل نمود %~% لاجرم بازارها در روز بود\r\n"
    },
    {
      "line_number": 12978,
      "char_start": 807077,
      "char_end": 807145,
      "text": "# 23 تا که قلب و نقد نیک آید پدید %~% تا بود از غبن و از حیله بعید\r\n"
    },
    {
      "line_number": 12979,
      "char_start": 807145,
      "char_end": 807207,
      "text": "# 24 تا که نورش کامل آمد در زمین %~% تاجران را رحمة للعالمین\r\n"
    },
    {
      "line_number": 12980,
      "char_start": 807207,
      "char_end": 807276,
      "text": "# 25 لیک بر قلاب مبغوضست و سخت %~% زانک ازو شد کاسد او را نقد و رخت\r\n"
    },
    {
      "line_number": 12981,
      "char_start": 807276,
      "char_end": 807334,
      "text": "# 26 پس عدو جان صرافست قلب %~% دشمن درویش کی بود غیر کلب\r\n"
    },
    {
      "line_number": 12982,
      "char_start": 807334,
      "char_end": 807395,
      "text": "# 27 انبیا با دشمنان بر می‌تنند %~% پس ملایک رب سلم می‌زنند\r\n"
    },
    {
      "line_number": 12983,
      "char_start": 807395,
      "char_end": 807464,
      "text": "# 28 کین چراغی را که هست او نور کار %~% از پف و دمهای دزدان دور دار\r\n"
    },
    {
      "line_number": 12984,
      "char_start": 807464,
      "char_end": 807525,
      "text": "# 29 دزد و قلابست خصم نور بس %~% زین دو ای فریادرس فریاد رس\r\n"
    },
    {
      "line_number": 12985,
      "char_start": 807525,
      "char_end": 807586,
      "text": "# 30 روشنی بر دفتر چارم بریز %~% کآفتاب از چرخ چارم کرد خیز\r\n"
    },
    {
      "line_number": 12986,
      "char_start": 807586,
      "char_end": 807651,
      "text": "# 31 هین ز چارم نور ده خورشیدوار %~% تا بتابد بر بلاد و بر دیار\r\n"
    },
    {
      "line_number": 12987,
      "char_start": 807651,
      "char_end": 807721,
      "text": "# 32 هر کش افسانه بخواند افسانه است %~% وآنک دیدش نقد خود مردانه است\r\n"
    },
    {
      "line_number": 12988,
      "char_start": 807721,
      "char_end": 807795,
      "text": "# 33 آب نیلست و به قبطی خون نمود ms0557 %~% قوم موسی را نه خون بد آب بود\r\n"
