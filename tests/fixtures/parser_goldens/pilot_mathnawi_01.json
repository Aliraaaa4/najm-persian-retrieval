      "char_start": 808768,
      "char_end": 808834,
      "text": "# 10 هم بر آن بو می‌تنند و می‌روند %~% هر دمی راجی و آیس می‌شوند\r\n"
    },
    {
      "line_number": 13005,
      "char_start": 808834,
      "char_end": 808894,
      "text": "# 11 هر کسی را هست اومید بری %~% که گشادندش در آن روزی دری\r\n"
    },
    {
      "line_number": 13006,
      "char_start": 808894,
      "char_end": 808956,
      "text": "# 12 باز در بستندش و آن درپرست %~% بر همان اومید آتش پا شدست\r\n"
    },
    {
      "line_number": 13007,
      "char_start": 808956,
      "char_end": 809027,
      "text": "# 13 چون درآمد خوش در آن باغ آن جوان %~% خود فرو شد پا به گنجش ناگهان\r\n"
    },
    {
      "line_number": 13008,
      "char_start": 809027,
      "char_end": 809089,
      "text": "# 14 مر عسس را ساخته یزدان سبب %~% تا ز بیم او دود در باغ شب\r\n"
    },
    {
      "line_number": 13009,
      "char_start": 809089,
      "char_end": 809152,
      "text": "# 15 بیند آن معشوقه را او با چراغ %~% طالب انگشتری در جوی باغ\r\n"
    },
    {
      "line_number": 13010,
      "char_start": 809152,
      "char_end": 809221,
      "text": "# 16 پس قرین ms0558 می‌کرد از ذوق آن نفس %~% با ثنای حق دعای آن عسس\r\n"
    },
    {
      "line_number": 13011,
      "char_start": 809221,
      "char_end": 809290,
      "text": "# 17 که زیان کردم عسس را از گریز %~% بیست چندان سیم و زر بر وی بریز\r\n"
    },
    {
      "line_number": 13012,
      "char_start": 809290,
      "char_end": 809352,
      "text": "# 18 از عوانی مر ورا آزاد کن %~% آنچنان که شادم او را شاد کن\r\n"
    },
    {
      "line_number": 13013,
      "char_start": 809352,
      "char_end": 809416,
      "text": "# 19 سعد دارش این جهان و آن جهان %~% از عوانی و سگی‌اش وا رهان\r\n"
    },
    {
      "line_number": 13014,
      "char_start": 809416,
      "char_end": 809480,
      "text": "# 20 گرچه خوی آن عوان هست ای خدا %~% که هماره خلق را خواهد بلا\r\n"
    }
  ],
