      "char_end": 807916,
      "text": "# 35 ای ضیا الحق تو دیدی حال او %~% حق نمودت پاسخ افعال او\r\n"
    },
    {
      "line_number": 12991,
      "char_start": 807916,
      "char_end": 807984,
